digraph plant {
  rankdir=LR;
  node [shape=box, style="rounded,filled", fillcolor=white];
  "demande" [shape=oval, fillcolor=grey80];
  "decoupe_a" [label="decoupe_a\ncap=1", fillcolor="white"];
  "decoupe_b" [label="decoupe_b\ncap=1\nGOULOT", fillcolor="#FF6B6B"];
  "decoupe_c" [label="decoupe_c\ncap=1", fillcolor="white"];
  "assemblage" [label="assemblage\ncap=2", fillcolor="white"];
  "P1" [shape=box, style="rounded,filled", fillcolor="#BDD7EE"];
  "P2" [shape=box, style="rounded,filled", fillcolor="#BDD7EE"];
  "demande" -> "decoupe_a" [color="#4363D8", style=dashed, label="comp_a"];
  "demande" -> "decoupe_b" [color="#F58231", style=dashed, label="comp_b"];
  "demande" -> "decoupe_c" [color="#911EB4", style=dashed, label="comp_c"];
  "decoupe_a" -> "assemblage" [color="#E6194B", penwidth=2, label="comp_a x2.0"];
  "decoupe_b" -> "assemblage" [color="#E6194B", penwidth=2, label="comp_b x1.0"];
  "assemblage" -> "P1" [color="#E6194B", penwidth=2, label="t=4.0"];
  "decoupe_b" -> "assemblage" [color="#3CB44B", penwidth=2, label="comp_b x1.0"];
  "decoupe_c" -> "assemblage" [color="#3CB44B", penwidth=2, label="comp_c x2.0"];
  "assemblage" -> "P2" [color="#3CB44B", penwidth=2, label="t=5.0"];
}
